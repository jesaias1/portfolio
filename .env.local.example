# Contact form delivery. Resend is used when RESEND_API_KEY is set; otherwise Gmail SMTP is the fallback.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email).
RESEND_FROM="Jesaias Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=linasjesaias@gmail.com

# Gmail fallback (app password)
EMAIL_USER=
EMAIL_PASS=

# Optional: shared contact-form rate limit (Upstash Redis REST). Falls back to in-memory when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
